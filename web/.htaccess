# Startseite ist index.html, nicht die index.htm-Vorlage des Hosters
DirectoryIndex index.html

# Immer über HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Repo-Dateien nicht ausliefern
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

Options -Indexes
AddDefaultCharset UTF-8

# Oberfläche bei jedem Aufruf mit dem Server abgleichen (ETag, meist nur 304),
# damit nach einem Upload kein Browser alte JS- oder CSS-Dateien weiterverwendet
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
